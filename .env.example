# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is git-ignored: it is never committed, and the output bundle never includes it.
# Set a spending cap on the key in the Anthropic Console before running.
ANTHROPIC_API_KEY=

# Optional: the model the agents use (default claude-sonnet-5-5)
# FRAUDRANK_LLM_MODEL=claude-sonnet-5-5
