# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is git-ignored: it is never committed, and the output bundle never includes it.
# Get a key at aistudio.google.com (Get API key) and set a spending cap or use the free tier.
GEMINI_API_KEY=

# Optional: the model the agents use (default gemini-3.5-flash-lite). The exact version that answered is
# recorded in every cached response and in llm_usage.json.
# FRAUDRANK_LLM_MODEL=gemini-3.5-flash-lite

# Optional: sampling temperature (default: the model's own default)
# FRAUDRANK_LLM_TEMPERATURE=
