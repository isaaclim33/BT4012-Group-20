          "denominator": "n_claims",
          "rationale": "Ratio of unique beneficiaries to total claims, capturing patient reuse intensity."
        },
        {
          "name": "agent_ip_claim_ratio",
          "numerator": "n_ip_claims",
          "denominator": "n_claims",
          "rationale": "Proportion of claims that are inpatient."
        },
        {
          "name": "agent_op_claim_ratio",
          "numerator": "n_op_claims",
          "denominator": "n_claims",
          "rationale": "Proportion of claims that are outpatient."
        },
        {
          "name": "agent_ip_reimb_ratio",
          "numerator": "ip_total_reimb",
          "denominator": "total_reimb",
          "rationale": "Share of total reimbursement coming from inpatient claims."
        },
        {
          "name": "agent_attending_per_claim",
          "numerator": "n_attending",
          "denominator": "n_claims",
          "rationale": "Ratio of distinct attending physicians per claim to measure physician diversity."
        },
        {
          "name": "agent_operating_per_claim",
          "numerator": "n_operating",
          "denominator": "n_claims",
          "rationale": "Ratio of distinct operating physicians per claim."
        },
        {
          "name": "agent_states_per_bene",
          "numerator": "n_states",
          "denominator": "n_bene",
          "rationale": "Geographic dispersion of beneficiaries relative to beneficiary count."
