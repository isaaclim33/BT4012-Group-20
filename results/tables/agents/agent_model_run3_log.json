          "agg": "mean",
          "scope": "op",
          "rationale": "Tracks average number of diagnoses per outpatient claim for coding inflation."
        },
        {
          "name": "agent_nproc_max_ip",
          "column": "n_proc",
          "agg": "max",
          "scope": "ip",
          "rationale": "Identifies maximum procedures per inpatient claim to spot unusually heavy coding."
        },
        {
          "name": "agent_reimb_std_all",
          "column": "InscClaimAmtReimbursed",
          "agg": "std",
          "scope": "all",
          "rationale": "Measures overall dispersion of reimbursed amounts across all claims."
        },
        {
          "name": "agent_deductible_share_op",
          "column": "OPDeductible",
          "agg": "share_positive",
          "scope": "op",
          "rationale": "Proportion of outpatient claims with non-zero deductible reported."
        },
        {
          "name": "agent_age_median_all",
          "column": "age",
          "agg": "median",
          "scope": "all",
          "rationale": "Median beneficiary age treated by provider to check for demographic targeting."
        },
        {
          "name": "agent_chronic_mean_all",
          "column": "n_chronic",
          "agg": "mean",
          "scope": "all",
          "rationale": "Average chronic conditions per beneficiary associated with provider claims."
        },
        {
          "name": "agent_renal_share_all",
          "column": "RenalDiseaseIndicator",
          "agg": "share_positive",
          "scope": "all",
          "rationale": "Share of claims associated with renal disease indicator."
        },
        {
          "name": "agent_dead_share_all",
          "column": "bene_dead",
          "agg": "share_positive",
          "scope": "all",
          "rationale": "Share of claims where beneficiary is marked as deceased."
        },
        {
          "name": "agent_dup_any_share",
          "column": "dup_any_provider",
          "agg": "share_positive",
          "scope": "all",
          "rationale": "Proportion of claims flagged for any duplication."
        },
        {
          "name": "agent_att_is_op_share",
          "column": "att_is_op",
          "agg": "share_positive",
          "scope": "all",
          "rationale": "Share of claims where attending physician is also operating physician."
        }
      ],
      "ratios": [
        {
          "name": "agent_bene_per_claim",
