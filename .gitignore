# Python
__pycache__/
*.pyc

# virtual environments (either name)
.venv/
venv/

# secrets: your API key lives here, never commit it
.env

# Kaggle data: licensed and large; rebuilt from data/raw by 01_build_features.py
data/raw/
data/processed/

# large model files; rebuilt by 02_run_experiments.py
results/cache/*.pkl
# on Windows, model names with ':' become extension-less files with alternate streams
results/cache/oof_*

# bundle made for sending results, not part of the repo
agent_outputs_*.zip
# per-machine run log and environment, rewritten by run_agents_local.py and packed into the bundle
results/agent_run_log.txt
results/agent_environment.json

# editor and OS files
.vscode/
.DS_Store
Thumbs.db

# Word lock files, written while a document is open
~$*
